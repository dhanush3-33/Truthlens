# --- TruthLens AI backend configuration ---
# Copy this file to `.env` and fill in real values. NEVER commit the real .env file.

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# --- Evidence search provider ---
# One of: auto | tavily | brave | serpapi | duckduckgo | none
# "auto" picks the first provider whose API key is configured (duckduckgo needs no key,
# but is attempted last because it is less reliable).
EVIDENCE_PROVIDER=auto

# Tavily (https://tavily.com) - optional
TAVILY_API_KEY=

# Brave Search (https://brave.com/search/api/) - optional
BRAVE_API_KEY=

# SerpApi (https://serpapi.com) - optional
SERPAPI_API_KEY=

# --- Server settings ---
PORT=5001
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Request timeouts in seconds
AI_TIMEOUT_SECONDS=45
SEARCH_TIMEOUT_SECONDS=15
MAX_INPUT_CHARS=8000

# Development fallback: when true AND no GEMINI_API_KEY is set, the API returns a clearly
# labeled DEMO analysis (heuristics only, no real AI, verdict always "Unverified").
# It never pretends to perform real AI analysis or real evidence verification.
DEMO_MODE=true
